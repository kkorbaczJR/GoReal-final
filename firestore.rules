rules_version = '2';

// One document per account, users/<uid>, holding the saved progress as JSON (see lib/account.ts).
// Only the signed-in owner can read or write it, and only in that shape.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['data', 'rev', 'updatedAt'])
        && request.resource.data.data is string
        && request.resource.data.data.size() < 500000
        && request.resource.data.rev is int;
    }
  }
}
